{
  "name": "pyquests",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "sync:problems": "node scripts/extract-problem-ids.mjs",
    "check:problems": "node scripts/extract-problem-ids.mjs --check",
    "verify:sandbox": "node scripts/verify-js-sandbox.mjs",
    "csp:hash": "node scripts/csp-inline-hash.mjs",
    "verify:csp": "node scripts/verify-csp.mjs",
    "fetch:pyodide": "node scripts/fetch-pyodide-core.mjs --force",
    "fetch:sqljs": "node scripts/fetch-sqljs.mjs --force",
    "prebuild": "node scripts/fetch-pyodide-core.mjs && node scripts/fetch-sqljs.mjs",
    "verify:pyodide": "node scripts/verify-pyodide-loader.mjs",
    "verify:pyodide-core": "node scripts/verify-pyodide-core.mjs",
    "verify:sql": "node scripts/verify-sql-runner.mjs",
    "verify:guest-merge": "node scripts/verify-guest-merge.mjs",
    "verify:shared-pc": "node scripts/verify-shared-pc.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:all": "npm run lint && tsc -b && npm run test && npm run check:problems && npm run verify:sandbox && npm run verify:pyodide && npm run verify:sql && npm run verify:web && npm run verify:guest-merge && npm run verify:shared-pc && npm run check:site && npm run verify:routing",
    "build:site": "node scripts/build-site.mjs",
    "check:site": "node scripts/build-site.mjs --check",
    "verify:routing": "node scripts/verify-routing.mjs",
    "verify:web": "node scripts/verify-web-checks.mjs"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@supabase/supabase-js": "^2.112.3",
    "@uiw/react-codemirror": "^4.25.11",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
